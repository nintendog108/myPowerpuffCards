@startuml
package "Models" {
    class User {
        - int id
        - String username
        - String password
        - int coins
        - Stack stack
        - Deck deck
        - String token
    }

    class Card {
        - String Id
        - ElementType type
        - String name
        - double damage
        + getName()
        + getDamage()
        + getElementType()
        + setDamage()
        + setId()
    }

    class MonsterCard {
    }
    class SpellCard {
    }

    Card <|-- MonsterCard
    Card <|-- SpellCard

    class ElementType {
    }

    class CardPile {
        - List<Card> cards
    }
    class Deck {
        + defineDeck()
    }
    class Stack {
    }

    CardPile <|-- Deck
    CardPile <|-- Stack
}

package "Services" {
    class AuthService {
        - UsersDaoDb usersDaoDb
        + boolean authenticate(headers)
    }

    class BattleService {
        - UsersDaoDb usersDao
        + startBattle()
        + calculateRoundResult()
        + determineWinner()
    }

    class TradeService {
        - String tradeId
        - Card offeredCard
        - String requiredCardType
        - int minDamage
        + boolean validateCardForTrade()
        + List<TradeService> fetchAllTrades()
    }
}

package "Controllers" {
    class Controller {
        + handleRequest()
    }

    class CardController {
        + showAllCards()
        + configureDeck()
    }
    class UserController {
        + registerUser()
        + startBattle()
        + showScoreboard()
    }
    class PackageController {
        + createPackage()
        + acquirePackageController()
    }
    class SessionController {
        + createSession()
    }
    class TradeController {
        + createTrade()
        + acceptTrade()
        + listTrades()
    }

    Controller <|-- CardController
    Controller <|-- UserController
    Controller <|-- PackageController
    Controller <|-- SessionController
    Controller <|-- TradeController
}

package "Persistence" {
    class Dao<T> {
        + Optional<T> get(int id)
        + Optional<T> getText(String text)
        + Collection<T> getAll()
        + void save(T t)
        + void update(T t, String[] params)
        + void delete(T t)
    }

    class UsersDaoDb {
        + findUserByUsernameAndPassword()
        + userExists()
        + save()
        + update()
        + delete()
        + getDeck()
        + saveDeck()
        + clearDeck()
        + getCardsFromStack()
        + getUserStats()
        + getScoreboard()
    }

    class TradeDaoDb {
        + createTrade()
        + getAllTrades()
        + updateTradeStatus()
        + deleteTrade()
        + acceptTrade()
    }

    class CardDaoDb {
        + saveCard()
        + getCardById()
        + transferCard()
    }

    class PackageDaoDb {
        + savePackage()
        + acquirePackage()
        + generateDefaultPackages()
    }

    class TransactionDaoDb {
        + save()
        + update()
    }

    Dao <|.. UsersDaoDb
    Dao <|.. TradeDaoDb
    Dao <|.. CardDaoDb
    Dao <|.. PackageDaoDb
    Dao <|.. TransactionDaoDb
}

package "Server" {
    class HttpServer {
        + start(port)
    }

    class ClientHandler {
        + run()
    }

    class Router {
        + getController(route)
    }

    HttpServer --> Router
    Router --> Controller
    ClientHandler --> Router
    ClientHandler --> Controller
}
class DbConnection {
    + static DbConnection getInstance()
    + Connection connect(String database)
    + Connection connect()
    + synchronized Connection getConnection()
    + PreparedStatement prepareStatement(String sql)
    + void setAutoCommit(boolean autoCommit)
    + void commit()
    + void rollback()
    + static boolean executeSql(Connection connection, String sql)
    + static boolean executeSql(Connection connection, String sql, boolean ignoreIfFails)
    + void close()
    + static void initDb()
}

User -- Deck
User -- Stack
Deck -- Card
Stack -- Card
Card -- ElementType
BattleService -- UsersDaoDb
TradeService -- Card
TradeService -- TradeDaoDb
AuthService -- UsersDaoDb
TradeController -- TradeDaoDb
CardController -- UsersDaoDb
UserController -- UsersDaoDb
PackageController -- UsersDaoDb
PackageController -- PackageDaoDb
SessionController -- UsersDaoDb
DbConnection -- UsersDaoDb
DbConnection -- CardDaoDb
DbConnection -- PackageDaoDb
DbConnection -- TradeDaoDb
DbConnection -- TransactionDaoDb
@enduml
